        }
      }
    },
    "Stage %@ is Blocked": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 단계가 막혔습니다"
          }
        }
      }
    },
    "Stage %@ is Error": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 단계에 오류가 있습니다"
          }
