      "secondary":  { "light": "rgba(0, 0, 0, 0.55)", "dark": "rgba(255, 255, 255, 0.58)", "text": true },
      "tertiary":   { "light": "rgba(0, 0, 0, 0.45)", "dark": "rgba(255, 255, 255, 0.42)" },
      "hairline":   { "light": "rgba(0, 0, 0, 0.08)", "dark": "rgba(255, 255, 255, 0.08)" },
      "control":    { "light": "rgba(0, 0, 0, 0.05)", "dark": "rgba(255, 255, 255, 0.08)" },
      "track":      { "light": "rgba(0, 0, 0, 0.16)", "dark": "rgba(255, 255, 255, 0.2)" },
      "selection":  { "light": "rgba(0, 0, 0, 0.08)", "dark": "rgba(255, 255, 255, 0.11)" },
