      "green":  { "light": "#16743A", "dark": "#32D35F" },
      "blue":   { "light": "#0066D6", "dark": "#409CFF" },
      "red":    { "light": "#C8302E", "dark": "#FF5A5F" },
      "purple": { "light": "#8E3FC0", "dark": "#C77DFF" }
