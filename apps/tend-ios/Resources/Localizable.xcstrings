    },
    "Starting work is turned off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 시작이 꺼져 있습니다"
          }
        }
      }
    },
    "Starting work is turned off on this dashboard ([dashboard] allow_work_start).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대시보드에서는 작업 시작이 꺼져 있습니다([dashboard] allow_work_start)."
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
