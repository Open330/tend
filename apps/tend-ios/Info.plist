<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HTTPS through the system's TLS only, which is exempt: no export
	     compliance question on each TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- HTTPS everywhere; plain HTTP only to a loopback address (a scratch
	     or local daemon in the simulator). The app enforces the same rule
	     before it sends anything. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
