      "mono":       { "size": 12, "weight": "regular", "design": "monospaced" }
    },
    "space": { "xxs": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "xxxl": 32 },
    "radius": { "control": 6, "group": 8, "card": 10, "lane": 12 },
    "surface": {
      "sidebar": { "light": "#EFEFF2", "dark": "#232326" },
      "content": { "light": "#FFFFFF", "dark": "#1C1C1E" },
      "lane":    { "light": "#F4F4F6", "dark": "#232325" },
