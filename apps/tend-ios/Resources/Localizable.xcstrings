      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획된 Work는 Mac용 Tend나 대시보드에서 시작합니다. 여기서는 새 작업을 시작할 수 있습니다."
          }
        }
      }
    },
    "Planned, not started": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획만 있고 시작 전"
          }
        }
      }
    },
    "Project": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트"
