{
  "sourceLanguage": "en",
  "strings": {
    "%@ (dashboard host)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (대시보드 호스트)"
          }
        }
      }
    },
    "%@ did not start it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 시작하지 않았습니다."
          }
        }
      }
    },
    "%@ has no pipeline configured. Add one to its tend config to start work there.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 설정된 파이프라인이 없습니다. 그 호스트의 tend 설정에 파이프라인을 추가해야 작업을 시작할 수 있습니다."
          }
        }
      }
    },
    "%@ is observe-only: keep or close its questions there.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 보기 전용입니다. 질문은 그 호스트에서 유지하거나 닫으세요."
          }
        }
      }
    },
    "%@ on %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %1$@"
          }
        }
      }
    },
    "%@, %lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld"
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%@: not everything could be read: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 일부를 읽지 못했습니다: %2$@"
          }
        }
      }
    },
    "%@: showing the first %lld; more are waiting.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: 처음 %2$lld개만 보여 줍니다. 더 기다리는 항목이 있습니다."
          }
        }
      }
    },
    "%@: showing the first ones; more are waiting.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 앞부분만 보여 줍니다. 더 기다리는 항목이 있습니다."
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld agents": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 %lld개"
          }
        }
      }
    },
    "%lld empty sessions": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 세션 %lld개"
          }
        }
      }
    },
    "%lld helper sessions": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 세션 %lld개"
          }
        }
      }
    },
    "%lld more need you in a form this app cannot show yet. Open the dashboard in a browser, or update the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이 아직 보여 줄 수 없는 형식으로 %lld개가 더 기다리고 있습니다. 브라우저에서 대시보드를 열거나 앱을 업데이트하세요."
          }
        }
      }
    },
    "%lld more not listed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 없는 질문이 %lld개 더 있습니다"
          }
        }
      }
    },
    "%lld need you": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개가 기다림"
          }
        }
      }
    },
    "%lld need you, maybe more": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개가 기다림, 더 있을 수 있음"
          }
        }
      }
    },
    "%lld need you, maybe more: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개가 기다림, 더 있을 수 있음: %2$@"
          }
        }
      }
    },
    "%lld older": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 항목 %lld개"
          }
        }
      }
    },
    "%lld older decided": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 결정한 것 %lld개"
          }
        }
      }
    },
    "%lld possible helper sessions": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 세션 후보 %lld개"
          }
        }
      }
    },
    "%lld this app cannot show": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이 보여 줄 수 없는 항목 %lld개"
          }
        }
      }
    },
    "%lld working": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 작업 중"
          }
        }
      }
    },
    "A notification says only which host needs you and how many. Tap it to open the item.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에는 어느 호스트에서 몇 개가 기다리는지만 표시됩니다. 알림을 누르면 그 항목이 열립니다."
          }
        }
      }
    },
    "A notification says only which host needs you and how many; tap it to open the item.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에는 어느 호스트에서 몇 개가 기다리는지만 표시됩니다. 알림을 누르면 그 항목이 열립니다."
          }
        }
      }
    },
    "A notification shows the question or result and who asked. The text passes through Apple and shows on the lock screen as far as iOS's Show Previews allows; turning this off stops later ones only. Accept, Return and Answer work from the notification once the phone is unlocked.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에 질문이나 결과와 물어본 쪽이 표시됩니다. 이 내용은 Apple을 거쳐 전달되고, iOS의 미리보기 표시 설정이 허용하는 만큼 잠금 화면에 보입니다. 이 설정을 끄면 이후 알림부터 적용됩니다. 수락, 돌려보내기, 답하기는 휴대폰 잠금을 푼 뒤 알림에서 바로 쓸 수 있습니다."
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락"
          }
        }
      }
    },
    "Accept with: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 수락: %@"
          }
        }
      }
    },
    "Accepted": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락함"
          }
        }
      }
    },
    "Accepted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락했습니다."
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 권한"
          }
        }
      }
    },
    "Agent": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트"
          }
        }
      }
    },
    "Agent exited": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 종료"
          }
        }
      }
    },
    "Agents": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트"
          }
        }
      }
    },
    "Agents are on it": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 진행 중"
          }
        }
      }
    },
    "Allow notifications for Tend in the Settings app first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 설정 앱에서 Tend의 알림을 허용하세요."
          }
        }
      }
    },
    "An operator limited this device to deciding. Your turn works as before. To see hosts and agents again, ask again; an operator approves it on the dashboard.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오퍼레이터가 이 기기를 결정 전용으로 제한했습니다. 내 차례는 전과 같이 쓸 수 있습니다. 호스트와 에이전트를 다시 보려면 다시 요청하세요. 오퍼레이터가 대시보드에서 승인합니다."
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답하기"
          }
        }
      }
    },
    "Answer what needs you; see every host and agent and their recent output; start new work, which runs agents on your hosts (Face ID first).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나를 기다리는 일에 답하고, 모든 호스트와 에이전트, 최근 출력을 보고, 새 작업을 시작합니다. 새 작업은 내 호스트에서 에이전트를 실행합니다(먼저 Face ID를 확인합니다)."
          }
        }
      }
    },
    "Answered": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변 완료"
          }
        }
      }
    },
    "Answered.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답했습니다."
          }
        }
      }
    },
    "Answer…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답하기…"
          }
        }
      }
    },
    "Approve this phone": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰 승인하기"
          }
        }
      }
    },
    "Ask for hosts and new work?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트와 새 작업 권한을 요청할까요?"
          }
        }
      }
    },
    "Ask the dashboard": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대시보드에 요청"
          }
        }
      }
    },
    "Asked": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맡긴 일"
          }
        }
      }
    },
    "Asked by %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청: %@"
          }
        }
      }
    },
    "Asked you": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답을 기다림"
          }
        }
      }
    },
    "Asker gone": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문한 에이전트 없음"
          }
        }
      }
    },
    "Asking": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문함"
          }
        }
      }
    },
    "Asks you to choose. Open to see the question.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택을 기다립니다. 열어서 질문을 확인하세요."
          }
        }
      }
    },
    "Authentication failed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 실패"
          }
        }
      }
    },
    "Back in Your turn.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 차례로 되돌렸습니다."
          }
        }
      }
    },
    "Backlog": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백로그"
          }
        }
      }
    },
    "Can't be answered (%lld)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답할 수 없는 질문 (%lld)"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        }
      }
    },
    "Check that the dashboard shows this phone's name before you approve it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하기 전에 대시보드에 이 휴대폰의 이름이 보이는지 확인하세요."
          }
        }
      }
    },
    "Close %lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 닫기"
          }
        }
      }
    },
    "Close %lld questions on %@?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 질문 %1$lld개를 닫을까요?"
          }
        }
      }
    },
    "Close %lld questions?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 %lld개를 닫을까요?"
          }
        }
      }
    },
    "Close 1 question on %@?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 질문 1개를 닫을까요?"
          }
        }
      }
    },
    "Close 1 question?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 1개를 닫을까요?"
          }
        }
      }
    },
    "Close All on %@…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 모두 닫기…"
          }
        }
      }
    },
    "Close All…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 닫기…"
          }
        }
      }
    },
    "Close all is turned off on %@; Keep still works.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서는 모두 닫기가 꺼져 있습니다. 유지는 할 수 있습니다."
          }
        }
      }
    },
    "Closed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫음"
          }
        }
      }
    },
    "Closed %lld questions.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 %lld개를 닫았습니다."
          }
        }
      }
    },
    "Closed 1 question.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 1개를 닫았습니다."
          }
        }
      }
    },
    "Closed by tend": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tend가 닫음"
          }
        }
      }
    },
    "Closed by tend: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tend가 닫음: %@"
          }
        }
      }
    },
    "Closed by tend: merged into another item": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tend가 닫음: 다른 항목에 합쳐졌습니다"
          }
        }
      }
    },
    "Closed by tend: nobody is left to act on it": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tend가 닫음: 처리할 주체가 남아 있지 않습니다"
          }
        }
      }
    },
    "Closed by tend: the original request is gone": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tend가 닫음: 원래 요청이 없어졌습니다"
          }
        }
      }
    },
    "Closed by tend: the original request no longer waits": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tend가 닫음: 원래 요청이 더 이상 기다리지 않습니다"
          }
        }
      }
    },
    "Closed by tend: the session it was about is gone (%@)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tend가 닫음: 대상 세션이 사라졌습니다 (%@)"
          }
        }
      }
    },
    "Closed, asker gone: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문한 에이전트가 없어 닫음: %@"
          }
        }
      }
    },
    "Collapsed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힘"
          }
        }
      }
    },
    "Connecting": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 중"
          }
        }
      }
    },
    "Could not be read in full": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 읽지 못했습니다"
          }
        }
      }
    },
    "Could not be read in full: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 읽지 못했습니다: %@"
          }
        }
      }
    },
    "Could not keep the key in this device's Keychain.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 키체인에 키를 저장하지 못했습니다."
          }
        }
      }
    },
    "Could not keep the new key in this device's Keychain. This device still decides with its current key; ask again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 키를 이 기기의 키체인에 저장하지 못했습니다. 이 기기는 지금 키로 계속 결정할 수 있습니다. 다시 요청하세요."
          }
        }
      }
    },
    "Could not keep the notification key in this device's Keychain. Notifications stay off; try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
