    "inset-border":     { "light": "rgba(0, 0, 0, 0.06)", "dark": "rgba(255, 255, 255, 0.07)" }
  },
  "state": {
    "$comment": "Agent and Work states (AgentStatus.swift, FleetHomeView.swift stage colours) by the colour token they wear.",
    "error": "red",
    "needs-input": "orange",
    "asked": "orange",
    "limited": "purple",
    "working": "blue",
    "idle": "mint",
    "done": "green",
    "your-turn": "orange",
    "in-progress": "blue",
    "finished": "green"
  },
  "brand": {
    "$comment": "The four-room mark (BrandMark.swift, assets/brand/tend/STATES.md).",
    "waiting": "#FFAA2B",
    "error": "#FF5A3C",
    "done": "#3FBF84",
    "ink": { "light": "#16181D", "dark": "#F2F3F5" },
    "dim": { "light": 0.22, "dark": 0.26 }
