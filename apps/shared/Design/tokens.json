{
  "$comment": "Tend's design tokens: one source for Tend for Mac and the web dashboard. Values follow apps/tend-macos/Sources/TendTheme.swift and BrandMark.swift (checked by crates/tend/tests-js/design-tokens.test.mjs); system colours are NSColor/UIColor.system* sampled in sRGB on macOS 27.2 in the default appearance (the 26-series palette), and the accent is controlAccentColor's default blue (a user's own accent choice is not followed). Edit here, then run `node scripts/design-tokens.mjs` to regenerate crates/tend/src/dashboard/web/tokens.css and apps/shared/Sources/TendDesignTokens.swift (which TendTheme.swift reads).",
  "color": {
    "activity-bar":     { "light": "#F8F8F8", "dark": "#181818", "swift": "activityBar" },
    "side-bar":         { "light": "#F8F8F8", "dark": "#181818", "swift": "sideBar" },
    "editor":           { "light": "#FFFFFF", "dark": "#1F1F1F", "swift": "editor" },
    "panel":            { "light": "#F8F8F8", "dark": "#181818", "swift": "panel" },
    "lane":             { "light": "#F8F8F8", "dark": "#252526", "swift": "panelFill" },
    "border":           { "light": "#E5E5E5", "dark": "#2B2B2B", "swift": "border" },
    "input-background": { "light": "#FFFFFF", "dark": "#313131", "swift": "inputBackground" },
    "input-border":     { "light": "#CECECE", "dark": "#3C3C3C", "swift": "inputBorder" },
    "segment-chip":     { "light": "#FFFFFF", "dark": "#3A3A3A", "swift": "segmentChip" },
    "hover":            { "light": "rgba(0, 0, 0, 0.05)", "dark": "rgba(255, 255, 255, 0.07)" },
    "pressed":          { "light": "rgba(0, 0, 0, 0.09)", "dark": "rgba(255, 255, 255, 0.12)" },
    "segment-track":    { "light": "rgba(0, 0, 0, 0.055)", "dark": "rgba(255, 255, 255, 0.06)" },
    "text":             { "light": "rgba(0, 0, 0, 0.85)", "dark": "rgba(255, 255, 255, 0.85)" },
    "text-secondary":   { "light": "rgba(0, 0, 0, 0.5)", "dark": "rgba(255, 255, 255, 0.55)" },
    "text-tertiary":    { "light": "rgba(0, 0, 0, 0.26)", "dark": "rgba(255, 255, 255, 0.25)" },
    "accent":           { "light": "#007AFF", "dark": "#007AFF" },
    "orange":           { "light": "#FF8D28", "dark": "#FF9230" },
    "blue":             { "light": "#0088FF", "dark": "#0091FF" },
    "green":            { "light": "#34C759", "dark": "#30D158" },
    "red":              { "light": "#FF383C", "dark": "#FF4245" },
    "purple":           { "light": "#CB30E0", "dark": "#DB34F2" },
    "mint":             { "light": "#00C8B3", "dark": "#00DAC3" },
