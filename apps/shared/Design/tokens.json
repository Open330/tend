  "mac": {
    "$comment": "Tend for Mac only (docs/proposals/MAC_DESIGN.md). Emitted to Swift as TendDesignTokens.Mac and never to CSS, so the web and iOS keep the shared values above. crates/tend/tests-js/design-tokens.test.mjs checks every text colour here on every surface here at 4.5:1 or more.",
    "type": {
      "page":       { "size": 20, "weight": "semibold" },
      "card-title": { "size": 14, "weight": "semibold" },
      "section":    { "size": 13, "weight": "semibold" },
      "body":       { "size": 13, "weight": "regular" },
      "secondary":  { "size": 12, "weight": "regular" },
      "label":      { "size": 11, "weight": "medium" },
