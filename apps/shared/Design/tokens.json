    ]
  },
  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, \"Apple SD Gothic Neo\", \"Malgun Gothic\", sans-serif",
